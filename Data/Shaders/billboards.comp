#version 430 compatibility
layout(local_size_x = 64) in;
struct Particle { vec4 positionScale; vec4 velocityAlpha; vec4 rotationActive; };
layout(std430, binding = 0) readonly buffer States { Particle particles[]; };
layout(std430, binding = 1) writeonly buffer Positions { float positions[]; };
layout(std430, binding = 2) writeonly buffer Colors { uint colors[]; };
uniform int particleCount;
uniform vec3 camera;
uniform float baseScale;
const vec2 corners[4] = vec2[4](vec2(-1,1),vec2(-1,-1),vec2(1,-1),vec2(1,1));
void main()
{
    uint i=gl_GlobalInvocationID.x;
    if (i >= uint(particleCount)) return;
    Particle p=particles[i];
    vec3 look=p.positionScale.xyz-camera;
    look = length(look)>0 ? normalize(look) : vec3(0,0,1);
    vec3 right=cross(vec3(0,1,0),look);
    float cs=cos(p.rotationActive.x), sn=sin(p.rotationActive.x);
    float size=p.rotationActive.z>0.5 ? p.positionScale.w*baseScale : 0;
    uint color=packUnorm4x8(vec4(1,1,1,p.rotationActive.z>0.5 ? p.velocityAlpha.w : 0));
    for (uint c=0; c<4; c++) {
        vec2 v=corners[c]*size;
        vec2 rotated=vec2(cs*v.x-sn*v.y,sn*v.x+cs*v.y);
        vec3 position=p.positionScale.xyz+right*rotated.x+vec3(0,1,0)*rotated.y;
        uint vertex=4*i+c;
        for (uint axis=0;axis<3;axis++) positions[3*vertex+axis]=position[axis];
        colors[vertex]=color;
    }
}
