; Independent M1 prototype. No imported content from the predecessor project.
config_version=5

[application]
config/name="Windward Circuit — Art Preview"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"
3d/default_gravity=26.0

[importer_defaults]
texture={
"mipmaps/generate": true
}

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.32,0.66,0.74,1)

[debug]
gdscript/warnings/integer_division=0

[shader_globals]

ir_motion_atlas={
"type": "sampler2D",
"value": ""
}
ir_motion_enabled={
"type": "bool",
"value": false
}
